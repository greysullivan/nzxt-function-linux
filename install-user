#!/bin/sh
set -eu
if [ "$#" -gt 1 ] || { [ "$#" -eq 1 ] && [ "$1" != --no-service ]; }; then
    echo 'Usage: sh install-user [--no-service]' >&2
    exit 2
fi
project_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
config_dir=${XDG_CONFIG_HOME:-$HOME/.config}
mkdir -p "$HOME/.local/bin" "$config_dir/systemd/user"
install -m 0755 "$project_dir/keys" "$HOME/.local/bin/keys"
for obsolete in trace sweep; do
    shortcut="$HOME/.local/bin/keys-$obsolete"
    if [ -L "$shortcut" ] && [ "$(readlink "$shortcut")" = keys ]; then
        unlink "$shortcut"
    fi
done
for colour in pink rose red orange amber yellow lime green teal cyan blue indigo purple violet magenta white off still impact; do
    shortcut="$HOME/.local/bin/keys-$colour"
    if [ -e "$shortcut" ] || [ -L "$shortcut" ]; then
        if [ "$(readlink "$shortcut" 2>/dev/null || true)" != keys ]; then
            echo "Refusing to replace existing $shortcut" >&2
            exit 1
        fi
    else
        ln -s keys "$shortcut"
    fi
done
install -m 0644 "$project_dir/keyboard-rgb.service" "$config_dir/systemd/user/keyboard-rgb.service"
if [ "${1:-}" != --no-service ]; then
    systemctl --user daemon-reload
    systemctl --user enable keyboard-rgb.service
    systemctl --user restart keyboard-rgb.service
fi
echo 'Installed keys, colour and scene shortcuts, and the restoration service unit.'
